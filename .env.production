DATABASE_PASSWORD=super_secure_production_password
STRIPE_SECRET_KEY=stripe-secret-placeholder
REDIS_URL=redis://production-cache:6379
SLACK_BOT_TOKEN=slack-bot-token-placeholder
AWS_ACCESS_KEY_ID=aws-access-key-placeholder
AWS_SECRET_ACCESS_KEY=aws-secret-key-placeholder
GITHUB_PAT=github-pat-placeholder

# ── App Configuration (Drift Detector) ──
DRIFT_DB_URI=postgresql://drift_admin:super_secure_pg_password@production-db:5432/drift_db
ENABLE_AUTO_REMEDIATION=true
WEBSOCKET_POLL_INTERVAL=1.5

# ── Alerting Webhooks ──
JIRA_WEBHOOK_URL=https://company.atlassian.net/rest/api/2/issue/
